@using FWO.Data.Workflow
@using FWO.Data
@using FWO.Data.Flow
@using FWO.Ui.Display
@using FWO.Ui.Shared
@using FWO.Ui.Services

@inject UserConfig userConfig
@inject ApiConnection apiConnection

<PopUp Title="@(userConfig.GetText("approval_access_task_view"))" Show="@Display" Size="PopupSize.XLarge" OnClose="Close">
    <Body>
        @if (Display)
        {
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-sm btn-secondary" @onclick="ToggleRuleDisplay">
                    @(DisplayService.DisplayButton(userConfig, technicalRuleView ? "resolved_view" : "technical_view", Icons.Swap))
                </button>
            </div>
            @foreach (List<WfReqTask> taskGroup in GetTaskGroups())
            {
                WfReqTask task = taskGroup[0];
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="d-flex align-items-start flex-wrap flex-grow-1 gap-2">
                            <small class="text-muted mr-2 text-nowrap" style="min-width: 10rem;">@(userConfig.GetText("id")): @TaskIds(taskGroup)</small>
                            <strong class="mr-2">@task.Title</strong>
                            @if (CanEdit(taskGroup, WorkflowEditableFieldKeys.Title))
                            {
                                <button type="button" class="btn btn-sm btn-warning" @onclick="() => OpenTextEditor(task, WorkflowEditableFieldKeys.Title, task.Title)">@(DisplayService.DisplayButton(userConfig, "edit", Icons.Edit))</button>
                            }
                            @if (taskGroup.Count > 1)
                            {
                                <span class="badge badge-secondary ml-2">@taskGroup.Count</span>
                            }
                        </span>
                        <span>@States.GetName(task.StateId)</span>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            @ReadOnlyValue(userConfig.GetText("handler"), Handlers(taskGroup))
                            @ReadOnlyValue(userConfig.GetText("assigned"), AssignedGroups(taskGroup))
                            @if (AccessTaskVisibility.ShowOwner)
                            {
                                @EditableValue(userConfig.GetText("owner"), Owners(taskGroup), CanEdit(taskGroup, WorkflowEditableFieldKeys.Owner), () => OpenOwnerEditor(task))
                            }
                            @if (AccessTaskVisibility.ShowManagement)
                            {
                                @EditableValue(userConfig.GetText("management"), ManagementIds(taskGroup), CanEdit(taskGroup, WorkflowEditableFieldKeys.Management), () => OpenManagementEditor(task))
                            }
                        </div>
                        <div class="form-group row">
                            @EditableValue(userConfig.GetText("rule_action"), RuleActions(taskGroup), CanEdit(taskGroup, WorkflowEditableFieldKeys.RuleAction), () => OpenRuleActionEditor(task))
                            @EditableValue(userConfig.GetText("track"), Trackings(taskGroup), CanEdit(taskGroup, WorkflowEditableFieldKeys.Track), () => OpenTrackingEditor(task))
                            @if (AccessTaskVisibility.ShowValidFrom || AccessTaskVisibility.ShowValidTo)
                            {
                                @EditableValue(userConfig.GetText("time_object"), TimeObjectDisplay(taskGroup), CanEditTimeObject(taskGroup), () => OpenTargetDatesEditor(task, EditableTimeObjectField(taskGroup)), "col-xl-6 col-lg-6 mb-2")
                            }
                        </div>
                        <div class="form-group row">
                            @if (AccessTaskVisibility.ShowReason)
                            {
                                @EditableValue(userConfig.GetText("reason"), DistinctValues(taskGroup, t => t.Reason), CanEdit(taskGroup, WorkflowEditableFieldKeys.Reason), () => OpenTextEditor(task, WorkflowEditableFieldKeys.Reason, task.Reason ?? ""), "col-xl-6 col-lg-6 mb-2")
                            }
                            @if (AccessTaskVisibility.ShowFreeText)
                            {
                                @EditableValue(userConfig.GetText("free_text"), DistinctValues(taskGroup, t => t.FreeText), CanEdit(taskGroup, WorkflowEditableFieldKeys.FreeText), () => OpenTextEditor(task, WorkflowEditableFieldKeys.FreeText, task.FreeText ?? ""), "col-xl-6 col-lg-6 mb-2")
                            }
                        </div>
                        <div class="form-group row">
                            @EditableListValue(userConfig.GetText("source"), RuleElementValues(taskGroup, ElemFieldType.source), CanEdit(taskGroup, WorkflowEditableFieldKeys.Source), () => EditField(task, WorkflowEditableFieldKeys.Source))
                            @EditableListValue(userConfig.GetText("destination"), RuleElementValues(taskGroup, ElemFieldType.destination), CanEdit(taskGroup, WorkflowEditableFieldKeys.Destination), () => EditField(task, WorkflowEditableFieldKeys.Destination))
                            @EditableListValue(userConfig.GetText("services"), RuleElementValues(taskGroup, ElemFieldType.service), CanEdit(taskGroup, WorkflowEditableFieldKeys.Services), () => EditField(task, WorkflowEditableFieldKeys.Services))
                        </div>
                    </div>
                </div>
            }
        }
    </Body>
    <Footer>
        <button type="button" class="btn btn-sm btn-primary" @onclick="Close">@(userConfig.GetText("ok"))</button>
    </Footer>
</PopUp>

<RuleActionEditor @bind-Display="displayRuleActionEditor" SelectedRuleAction="selectedRuleAction"
    RuleActions="ruleActions" Saved="SaveRuleAction" />
<OwnerEditor @bind-Display="displayOwnerEditor" SelectedOwner="selectedOwner"
    Owners="OwnerOptions" Saved="SaveOwner" />
<TrackingEditor @bind-Display="displayTrackingEditor" SelectedTracking="selectedTracking"
    Trackings="trackings" Saved="SaveTracking" />
<ManagementEditor @bind-Display="displayManagementEditor" SelectedManagement="selectedManagement"
    Managements="ManagementOptions" Saved="SaveManagement" />
<TargetDatesEditor @bind-Display="displayTargetDatesEditor"
    Model="targetDatesEditorModel"
    Saved="SaveTargetDates" />
<TextEditor @bind-Display="displayTextEditor" Text="@textEditorValue" TextKey="@textEditorKey"
    Multiline="@textEditorMultiline" Rows="5" Saved="SaveText" />

@code {
    [Parameter] public bool Display { get; set; }
    [Parameter] public EventCallback<bool> DisplayChanged { get; set; }
    [Parameter] public WfHandler WfHandler { get; set; } = new();
    [Parameter] public WfStateDict States { get; set; } = new();
    [Parameter] public Func<WfReqTask, string, Task> EditField { get; set; } = (_, _) => Task.CompletedTask;

    private ApproverAllowedChangesConfig AllowedChanges =>
        ApproverAllowedChangesConfig.Parse(userConfig.ReqAllowedChangesByApprover);

    private AccessTaskFieldVisibilityConfig AccessTaskVisibility =>
        TicketFieldVisibilityConfig.Parse(userConfig.ReqTicketFieldVisibility).AccessTask;

    private FlowIntegrationConfig FlowIntegration => FlowIntegrationConfig.Parse(userConfig.ReqFlowIntegration);
    private IReadOnlyDictionary<string, string> TimeObjectOriginSuffixes =>
        TimeObjectNamingHelper.ParseSuffixes(userConfig.ReqTimeObjectOriginSuffixes);
    private bool technicalRuleView;
    private List<ComplianceNetworkZone> networkZones = [];
    private List<IpProtocol> ipProtocols = [];

    private List<RuleAction> ruleActions = [];
    private List<Tracking> trackings = [];
    private bool displayOwnerEditor;
    private WfReqTask? editingOwnerTask;
    private FwoOwner selectedOwner = new();
    private bool displayRuleActionEditor;
    private WfReqTask? editingRuleActionTask;
    private RuleAction? selectedRuleAction;
    private bool displayTrackingEditor;
    private WfReqTask? editingTrackingTask;
    private Tracking? selectedTracking;
    private bool displayManagementEditor;
    private WfReqTask? editingManagementTask;
    private Management? selectedManagement;
    private bool displayTargetDatesEditor;
    private WfReqTask? editingTargetDatesTask;
    private TargetDatesEditorModel targetDatesEditorModel = new();
    private bool displayTextEditor;
    private WfReqTask? editingTextTask;
    private string textEditorKey = "title";
    private string textEditorValue = "";
    private bool textEditorMultiline;

    private List<FwoOwner> OwnerOptions => WfHandler.AllOwners.Where(owner => owner.Id != 0).ToList();
    private List<Management> ManagementOptions => WfHandler.Managements;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ruleActions = await apiConnection.SendQueryAsync<List<RuleAction>>(StmQueries.getRuleActions) ?? [];
            trackings = await apiConnection.SendQueryAsync<List<Tracking>>(StmQueries.getTracking) ?? [];
            ipProtocols = await apiConnection.SendQueryAsync<List<IpProtocol>>(StmQueries.getIpProtocols) ?? [];
            if (userConfig.DesignatedZoneMatrixId > 0)
            {
                networkZones = await apiConnection.SendQueryAsync<List<ComplianceNetworkZone>>(
                    NetworkZoneQueries.getNetworkZonesForMatrix,
                    new { criterionId = userConfig.DesignatedZoneMatrixId }) ?? [];
            }
        }
        catch
        {
            // The IDs remain useful as a fallback when the lookup data is unavailable.
            ruleActions = [];
            trackings = [];
        }
    }

    private IEnumerable<List<WfReqTask>> GetTaskGroups()
    {
        IEnumerable<WfReqTask> tasks = WfHandler.ActTicket.Tasks
            .Where(task => task.TaskType == WfTaskType.access.ToString());

        if (!userConfig.ReqDisplayBundledTasksAsOne || !userConfig.ReqConsiderBundling)
        {
            return tasks.Select(task => new List<WfReqTask> { task });
        }

        return tasks.GroupBy(task =>
        {
            string bundleId = task.GetAddInfoValue(AdditionalInfoKeys.FlowBundleId);
            return string.IsNullOrWhiteSpace(bundleId)
                ? $"task:{task.Id}"
                : $"bundle:{bundleId}:state:{task.StateId}";
        }).Select(group => group.OrderBy(task => task.Id).ToList());
    }

    private bool CanEdit(IEnumerable<WfReqTask> tasks, string fieldKey)
    {
        return ApproverAllowedChangesAccess.CanEditTaskField(AllowedChanges, new()
        {
            IsApprovalPhase = true,
            ApproveReqTaskMode = true,
            ReadOnlyMode = WfHandler.ReadOnlyMode,
            TaskType = WfTaskType.access,
            HasImplementationTasks = tasks.Any(task => task.ImplementationTasks.Count > 0)
        }, fieldKey);
    }

    private Task OpenOwnerEditor(WfReqTask task)
    {
        editingOwnerTask = task;
        FwoOwner? owner = task.Owners.FirstOrDefault()?.Owner;
        selectedOwner = OwnerOptions.FirstOrDefault(candidate => candidate.Id == owner?.Id) ?? new FwoOwner();
        displayOwnerEditor = true;
        return Task.CompletedTask;
    }

    private Task OpenRuleActionEditor(WfReqTask task)
    {
        editingRuleActionTask = task;
        selectedRuleAction = ruleActions.FirstOrDefault(action => action.Id == task.RuleAction);
        displayRuleActionEditor = true;
        return Task.CompletedTask;
    }

    private Task OpenTrackingEditor(WfReqTask task)
    {
        editingTrackingTask = task;
        selectedTracking = trackings.FirstOrDefault(tracking => tracking.Id == task.Tracking);
        displayTrackingEditor = true;
        return Task.CompletedTask;
    }

    private Task OpenManagementEditor(WfReqTask task)
    {
        editingManagementTask = task;
        selectedManagement = ManagementOptions.FirstOrDefault(management => management.Id == task.ManagementId);
        displayManagementEditor = true;
        return Task.CompletedTask;
    }

    private Task OpenTargetDatesEditor(WfReqTask task, string fieldKey)
    {
        editingTargetDatesTask = task;
        WfReqElement? timeElement = TimeObjectElementHelper.Find(task.Elements);
        long? timeObjectId = TimeObjectElementHelper.GetSelectorId(timeElement);
        long? ticketElementId = null;
        WfReqElement? parallelTimeElement = TimeObjectReferenceResolver.FindParallelTimeElement(
            WfHandler.ActTicket.Tasks, task, timeObjectId, ticketElementId);
        string? timeObjectName = timeElement?.Name;
        TimeObjectOrigin? timeObjectOrigin = ParseTimeObjectOrigin(task.GetAddInfoValue(AdditionalInfoKeys.TimeObjectOrigin));
        if (parallelTimeElement != null)
        {
            timeObjectName ??= parallelTimeElement.Name;
            timeObjectId ??= TimeObjectReferenceResolver.GetSelectorId(parallelTimeElement);
            timeObjectOrigin ??= TimeObjectOrigin.Requester;
            ticketElementId = parallelTimeElement.Id;
        }
        targetDatesEditorModel = new TargetDatesEditorModel
        {
            BeginDate = parallelTimeElement?.StartTime ?? task.TargetBeginDate,
            EndDate = parallelTimeElement?.EndTime ?? task.TargetEndDate,
            FlowTimeObjectId = timeObjectId,
            TicketElementId = parallelTimeElement?.Id ?? ticketElementId,
            FlowTimeObjectName = timeObjectName,
            FlowTimeObjectOrigin = timeObjectOrigin,
            TicketTimeObjects = GetTicketTimeObjects(),
            TicketTimeObjectElementIds = GetTicketTimeObjectElementIds(),
            ShowBeginDate = AccessTaskVisibility.ShowValidFrom,
            ShowEndDate = AccessTaskVisibility.ShowValidTo
        };
        displayTargetDatesEditor = true;
        return Task.CompletedTask;
    }

    private Task OpenTextEditor(WfReqTask task, string fieldKey, string value)
    {
        editingTextTask = task;
        textEditorKey = fieldKey;
        textEditorValue = value;
        textEditorMultiline = fieldKey != WorkflowEditableFieldKeys.Title;
        displayTextEditor = true;
        return Task.CompletedTask;
    }

    private async Task SaveRuleAction(RuleAction? ruleAction)
    {
        if (editingRuleActionTask == null)
        {
            return;
        }

        WfHandler.SetReqTaskEnv(editingRuleActionTask);
        WfHandler.ActReqTask.RuleAction = ruleAction?.Id;
        await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        editingRuleActionTask = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveOwner(FwoOwner owner)
    {
        if (editingOwnerTask == null)
        {
            return;
        }

        WfHandler.SetReqTaskEnv(editingOwnerTask);
        FwoOwner? oldOwner = editingOwnerTask.Owners.FirstOrDefault()?.Owner;
        WfHandler.ActReqTask.RemovedOwners = oldOwner == null || oldOwner.Id == owner.Id ? [] : [oldOwner];
        WfHandler.ActReqTask.NewOwners = oldOwner != null && oldOwner.Id == owner.Id ? [] : [owner];
        WfHandler.ActReqTask.Owners = oldOwner == null ? [] : [new FwoOwnerDataHelper { Owner = oldOwner }];
        await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        editingOwnerTask = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveTracking(Tracking? tracking)
    {
        if (editingTrackingTask == null)
        {
            return;
        }

        WfHandler.SetReqTaskEnv(editingTrackingTask);
        WfHandler.ActReqTask.Tracking = tracking?.Id;
        await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        editingTrackingTask = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveManagement(Management? management)
    {
        if (editingManagementTask == null)
        {
            return;
        }

        WfHandler.SetReqTaskEnv(editingManagementTask);
        WfHandler.ActReqTask.ManagementId = management?.Id;
        await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        editingManagementTask = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveTargetDates(TargetDatesEditorModel model)
    {
        if (editingTargetDatesTask == null)
        {
            return;
        }

        foreach (WfReqTask task in GetTasksToUpdate(editingTargetDatesTask))
        {
            WfHandler.SetReqTaskEnv(task);
            ApplyTimeObjectModel(model);
            await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        }
        editingTargetDatesTask = null;
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<WfReqTask> GetTasksToUpdate(WfReqTask task)
    {
        string bundleId = task.GetAddInfoValue(AdditionalInfoKeys.FlowBundleId);
        if (!userConfig.ReqDisplayBundledTasksAsOne || !userConfig.ReqConsiderBundling || string.IsNullOrWhiteSpace(bundleId))
        {
            return new List<WfReqTask> { task };
        }

        return WfHandler.ActTicket.Tasks.Where(candidate =>
            candidate.TaskType == task.TaskType
            && candidate.StateId == task.StateId
            && candidate.GetAddInfoValue(AdditionalInfoKeys.FlowBundleId) == bundleId);
    }

    private void ApplyTimeObjectModel(TargetDatesEditorModel model)
    {
        WfHandler.ActReqTask.TargetBeginDate = model.BeginDate;
        WfHandler.ActReqTask.TargetEndDate = model.EndDate;
        if (!model.FlowTimeObjectId.HasValue || model.FlowTimeObjectId.Value == 0)
        {
            WfReqElement? existingTimeElement = TimeObjectElementHelper.Find(WfHandler.ActReqTask.Elements);
            if (existingTimeElement != null)
            {
                WfHandler.ActReqTask.Elements.Remove(existingTimeElement);
                if (existingTimeElement.Id > 0)
                    WfHandler.ActReqTask.RemovedElements.Add(existingTimeElement);
            }
            WfHandler.ActReqTask.RemoveAddInfo(AdditionalInfoKeys.TimeObjectOrigin);
            return;
        }

        WfReqElement timeElement = TimeObjectElementHelper.GetOrCreate(WfHandler.ActReqTask);
        if (model.FlowTimeObjectId.Value > 0)
        {
            TimeObjectElementHelper.SetReference(timeElement, model.FlowTimeObjectId.Value);
        }
        else
        {
            WfReqTask? ticketTimeObjectTask = TimeObjectReferenceResolver.FindParallelTimeTask(
                WfHandler.ActTicket.Tasks, WfHandler.ActReqTask, model.FlowTimeObjectId, model.TicketElementId);
            if (ticketTimeObjectTask != null)
                TimeObjectElementHelper.SetTicketTaskReference(timeElement, ticketTimeObjectTask.Id);
            else
                TimeObjectElementHelper.ClearReference(timeElement);
        }
        timeElement.Name = model.FlowTimeObjectName;
        timeElement.StartTime = model.BeginDate;
        timeElement.EndTime = model.EndDate;
        WfHandler.ActReqTask.SetAddInfo(AdditionalInfoKeys.TimeObjectOrigin, TimeObjectOrigin.Approver.ToString());
    }

    private List<FlowTimeObject> GetTicketTimeObjects()
    {
        return [.. TimeObjectReferenceResolver.GetTicketTimeElements(WfHandler.ActTicket.Tasks)
            .Select(element => new FlowTimeObject
            {
                Id = TimeObjectReferenceResolver.GetSelectorId(element),
                Name = element.Name ?? "",
                StartTime = element.StartTime,
                EndTime = element.EndTime
            })
            .Where(timeObject => timeObject.Id != 0)
            .DistinctBy(timeObject => timeObject.Id)];
    }

    private Dictionary<long, long> GetTicketTimeObjectElementIds()
    {
        return TimeObjectReferenceResolver.GetTicketTimeElements(WfHandler.ActTicket.Tasks)
            .Where(element => element.Id != 0)
            .GroupBy(TimeObjectReferenceResolver.GetSelectorId)
            .ToDictionary(group => group.Key, group => group.First().Id);
    }


    private static TimeObjectOrigin? ParseTimeObjectOrigin(string value)
    {
        return Enum.TryParse(value, true, out TimeObjectOrigin origin) ? origin : null;
    }

    private async Task SaveText(string value)
    {
        if (editingTextTask == null)
        {
            return;
        }

        WfHandler.SetReqTaskEnv(editingTextTask);
        switch (textEditorKey)
        {
            case WorkflowEditableFieldKeys.Title:
                WfHandler.ActReqTask.Title = value;
                break;
            case WorkflowEditableFieldKeys.Reason:
                WfHandler.ActReqTask.Reason = value;
                break;
            case WorkflowEditableFieldKeys.FreeText:
                WfHandler.ActReqTask.FreeText = value;
                break;
        }

        await WfHandler.ChangeReqTask(allowLockedApprovalUpdate: true);
        editingTextTask = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string TaskIds(IEnumerable<WfReqTask> tasks) => string.Join(", ", tasks.Select(task => task.Id));

    private static string Handlers(IEnumerable<WfReqTask> tasks) => string.Join(", ", tasks
        .Select(task => task.CurrentHandler?.Name)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct());

    private static string AssignedGroups(IEnumerable<WfReqTask> tasks) => string.Join(", ", tasks
        .Select(task => task.AssignedGroup)
        .Where(group => !string.IsNullOrWhiteSpace(group))
        .Distinct());

    private static string ManagementIds(IEnumerable<WfReqTask> tasks) => string.Join(", ", tasks
        .Select(task => task.ManagementId?.ToString())
        .Where(id => !string.IsNullOrWhiteSpace(id))
        .Distinct());

    private static string Owners(IEnumerable<WfReqTask> tasks) => string.Join(", ", tasks
        .SelectMany(task => task.Owners)
        .Select(owner => owner.Owner?.Name)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct());

    private static string DistinctValues(IEnumerable<WfReqTask> tasks, Func<WfReqTask, string?> selector) => string.Join("; ", tasks
        .Select(selector)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct());

    private string Dates(IEnumerable<WfReqTask> tasks, bool isEndDate) => string.Join("; ", tasks
        .Select(task => EffectiveTimeObjectDate(task, isEndDate))
        .OfType<DateTime>()
        .Select(date => FormatDate(date, isEndDate))
        .Distinct());

    private string TimeObjectNames(IEnumerable<WfReqTask> tasks) => string.Join("; ", tasks
        .Select(GetTimeObjectName)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct());

    private string TimeObjectDisplay(IEnumerable<WfReqTask> tasks)
    {
        string name = TimeObjectNames(tasks);
        string begin = AccessTaskVisibility.ShowValidFrom ? Dates(tasks, false) : "";
        string end = AccessTaskVisibility.ShowValidTo ? Dates(tasks, true) : "";
        string validity = string.IsNullOrWhiteSpace(begin) ? end
            : string.IsNullOrWhiteSpace(end) ? begin
            : $"{begin} - {end}";
        return string.IsNullOrWhiteSpace(validity) ? name
            : string.IsNullOrWhiteSpace(name) ? $"({validity})"
            : $"{name} ({validity})";
    }

    private bool CanEditTimeObject(IEnumerable<WfReqTask> tasks) =>
        (AccessTaskVisibility.ShowValidFrom && CanEdit(tasks, WorkflowEditableFieldKeys.ValidFrom))
        || (AccessTaskVisibility.ShowValidTo && CanEdit(tasks, WorkflowEditableFieldKeys.ValidTo));

    private string EditableTimeObjectField(IEnumerable<WfReqTask> tasks) =>
        AccessTaskVisibility.ShowValidFrom && CanEdit(tasks, WorkflowEditableFieldKeys.ValidFrom)
            ? WorkflowEditableFieldKeys.ValidFrom
            : WorkflowEditableFieldKeys.ValidTo;

    private string GetTimeObjectName(WfReqTask task)
    {
        WfReqElement? timeElement = TimeObjectElementHelper.Find(task.Elements);
        WfReqElement? effectiveTimeElement = TimeObjectReferenceResolver.FindParallelTimeElement(
            WfHandler.ActTicket.Tasks, task, null, null) ?? timeElement;
        string name = effectiveTimeElement?.Name ?? "";
        TimeObjectOrigin? origin = ParseTimeObjectOrigin(task.GetAddInfoValue(AdditionalInfoKeys.TimeObjectOrigin));
        if (string.IsNullOrWhiteSpace(name))
        {
            long? timeObjectId = TimeObjectElementHelper.GetSelectorId(timeElement);
            WfReqElement? parallelTimeElement = TimeObjectReferenceResolver.FindParallelTimeElement(
                WfHandler.ActTicket.Tasks, task, timeObjectId, null);
            name = parallelTimeElement?.Name ?? TimeObjectNamingHelper.BuildDateBasedName(
                task.TargetBeginDate, task.TargetEndDate, FlowIntegration.TimeObjectPrecision);
            origin ??= parallelTimeElement == null ? null : TimeObjectOrigin.Requester;
        }

        return TimeObjectNamingHelper.BuildDisplayName(name, origin, TimeObjectOriginSuffixes);
    }

    private DateTime? EffectiveTimeObjectDate(WfReqTask task, bool isEndDate)
    {
        WfReqElement? timeElement = TimeObjectReferenceResolver.FindParallelTimeElement(
            WfHandler.ActTicket.Tasks, task, null, null);
        return timeElement == null
            ? isEndDate ? task.TargetEndDate : task.TargetBeginDate
            : isEndDate ? timeElement.EndTime : timeElement.StartTime;
    }

    private string RuleActions(IEnumerable<WfReqTask> tasks) => string.Join("; ", tasks
        .Select(task => ruleActions.FirstOrDefault(action => action.Id == task.RuleAction)?.Name ?? task.RuleAction?.ToString())
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct());

    private string Trackings(IEnumerable<WfReqTask> tasks) => string.Join("; ", tasks
        .Select(task => trackings.FirstOrDefault(tracking => tracking.Id == task.Tracking)?.Name ?? task.Tracking?.ToString())
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct());

    private void ToggleRuleDisplay()
    {
        technicalRuleView = !technicalRuleView;
    }

    private IEnumerable<string> RuleElementValues(IEnumerable<WfReqTask> tasks, ElemFieldType field)
    {
        return technicalRuleView
            ? TechnicalElementValues(tasks, field)
            : ResolvedElementValues(tasks, field);
    }

    private IEnumerable<string> ResolvedElementValues(IEnumerable<WfReqTask> tasks, ElemFieldType field) => tasks
        .SelectMany(task => task.Elements)
        .Where(element => element.Field == field.ToString())
        .SelectMany(element => ExpandTicketGroup(element, field))
        .Select(ResolvedElementValue)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct();

    private IEnumerable<string> TechnicalElementValues(IEnumerable<WfReqTask> tasks, ElemFieldType field) => tasks
        .SelectMany(task => task.Elements)
        .Where(element => element.Field == field.ToString())
        .SelectMany(element => ExpandTicketGroup(element, field))
        .Select(TechnicalElementValue)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct();

    private IEnumerable<WfReqElement> ExpandTicketGroup(WfReqElement element, ElemFieldType field)
    {
        string groupName = !string.IsNullOrWhiteSpace(element.GroupName) ? element.GroupName : element.Name ?? "";
        string memberField = field == ElemFieldType.service
            ? ElemFieldType.service.ToString()
            : ElemFieldType.source.ToString();

        List<WfReqTask> groupTasks = [.. WfHandler.ActTicket.Tasks
            .Where(task => task.TaskType is nameof(WfTaskType.group_create) or nameof(WfTaskType.group_modify))
            .Where(task => MatchesTicketGroup(task, element, groupName, memberField))];

        List<WfReqElement> members = [.. groupTasks
            .SelectMany(task => task.Elements)
            .Where(member => member.Field == memberField)
            .Where(member => !string.Equals(member.Name, groupName, StringComparison.OrdinalIgnoreCase)
                || member.IpString != null || member.Port.HasValue || member.ProtoId.HasValue)];

        return members.Count > 0 ? members : [element];
    }

    private static bool MatchesTicketGroup(WfReqTask task, WfReqElement element, string groupName, string memberField)
    {
        if (!string.IsNullOrWhiteSpace(groupName)
            && string.Equals(task.GetAddInfoValue(AdditionalInfoKeys.GrpName).Trim(), groupName.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return task.Elements.Any(candidate => candidate.Field == memberField
            && ((!string.IsNullOrWhiteSpace(groupName)
                    && (string.Equals(candidate.GroupName?.Trim(), groupName.Trim(), StringComparison.OrdinalIgnoreCase)
                        || string.Equals(candidate.Name?.Trim(), groupName.Trim(), StringComparison.OrdinalIgnoreCase)))
                || element.FlowNetworkGroupId.HasValue && candidate.FlowNetworkGroupId == element.FlowNetworkGroupId
                || element.FlowServiceGroupId.HasValue && candidate.FlowServiceGroupId == element.FlowServiceGroupId));
    }

    private string ResolvedElementValue(WfReqElement element)
    {
        string value = element.Field == ElemFieldType.service.ToString()
            ? ServiceValue(element)
            : ObjectValue(element);
        return AddZones(element, value);
    }

    private string TechnicalElementValue(WfReqElement element)
    {
        if (element.Field == ElemFieldType.service.ToString())
        {
            string service = DisplayBase.DisplayService(ToServiceElement(element), ipProtocols);
            return AddZones(element, string.IsNullOrWhiteSpace(service) ? ServiceValue(element) : service);
        }

        string ip = NwObjDisplay.DisplayIp(element.IpString, element.IpEnd);
        return AddZones(element, string.IsNullOrWhiteSpace(ip) ? ObjectValue(element) : ip);
    }

    private string ObjectValue(WfReqElement element)
    {
        return DisplayBase.DisplayIpWithName(WfElementBase.ToNetworkObject(element));
    }

    private string ServiceValue(WfReqElement element)
    {
        string name = element.Name ?? "";
        string details = DisplayBase.DisplayService(ToServiceElement(element), ipProtocols);
        return string.IsNullOrWhiteSpace(name) || string.Equals(name, details, StringComparison.OrdinalIgnoreCase)
            ? string.IsNullOrWhiteSpace(name) ? details : name
            : string.IsNullOrWhiteSpace(details) ? name : $"{name} ({details})";
    }

    private static NwServiceElement ToServiceElement(WfReqElement element)
    {
        return new NwServiceElement
        {
            Port = element.Port,
            PortEnd = element.PortEnd,
            ProtoId = element.ProtoId ?? 0,
            HasProtocol = element.ProtoId.HasValue,
            Name = element.Name
        };
    }

    private string AddZones(WfReqElement element, string value)
    {
        if (element.Field != ElemFieldType.source.ToString() && element.Field != ElemFieldType.destination.ToString())
        {
            return value;
        }

        string zones = Zones(element);
        return string.IsNullOrWhiteSpace(zones) ? value : $"{value} ({userConfig.GetText("zone")}: {zones})";
    }

    private string Zones(WfReqElement element)
    {
        var range = element.GetIpRange();
        if (range == null)
        {
            return "";
        }

        return string.Join(", ", networkZones
            .Where(zone => zone.IPRanges.Any(zoneRange => IpOperations.RangeOverlapExists(zoneRange, range)))
            .Select(zone => zone.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct());
    }

    private string FormatDate(DateTime date, bool isEndDate)
    {
        if (FlowIntegration.TimeObjectPrecision == FlowIntegrationTimePrecisionOptions.Date)
        {
            if (isEndDate && date.TimeOfDay == TimeSpan.Zero)
            {
                date = date.AddDays(-1);
            }
            return date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
        }

        return FlowIntegration.TimeObjectPrecision switch
        {
            FlowIntegrationTimePrecisionOptions.Hours => date.ToString("yyyy-MM-dd H 'h'", System.Globalization.CultureInfo.InvariantCulture),
            FlowIntegrationTimePrecisionOptions.Minutes => date.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture),
            _ => date.ToString("yyyy-MM-dd HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)
        };
    }

    private void Close()
    {
        Display = false;
        _ = DisplayChanged.InvokeAsync(false);
    }

